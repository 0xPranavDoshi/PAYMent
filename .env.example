# Copy to .env and fill in. Never commit real keys.

# Postgres connection string.
# Local:    postgres://postgres:postgres@localhost:5432/copayme
#           (docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=copayme postgres:17)
# Supabase: Connect > Direct > Session pooler URI (port 5432). Not the direct connection (IPv6 only)
#           and not the transaction pooler (no prepared statements). Add ?sslmode=require for
#           services that use their own postgres client; the scoring API requires TLS itself.
DATABASE_URL=

# Scoring API
PORT=8787
# The worker that settles picks and rescores users runs inside the API process.
# WORKER_ENABLED=false turns the schedule off; WORKER_INTERVAL_S sets the gap between runs (default 300).
WORKER_ENABLED=true
WORKER_INTERVAL_S=300
# Shared secret for POST /v1/posts (sent as the x-service-key header) - generate with: openssl rand -hex 32
SCORING_SERVICE_KEY=

# Trading service
TRADING_PORT=8788
# Where the scoring API reaches the trading service to notify it of new picks (uses TRADING_SERVICE_KEY)
TRADING_URL=http://localhost:8788
# Static key shared between services — generate with: openssl rand -hex 32
TRADING_SERVICE_KEY=

# Gemini Prediction Markets (sandbox keys from exchange.sandbox.gemini.com)
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Market data is read from production (sports markets don't exist on sandbox).
# Orders are placed on sandbox. These defaults are correct for development.
GEMINI_READ_BASE_URL=https://api.gemini.com
GEMINI_ORDER_BASE_URL=https://api.sandbox.gemini.com

# Scout service (Grok pipeline)
SCOUT_PORT=8789
APIFY_ACTOR_ID=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_TOKEN=
XAI_API_KEY=
# Verified working live on Nov 18 2026 (strict json_schema output).
XAI_MODEL=grok-4-1-fast-reasoning
INGEST_URL=
INGEST_SERVICE_KEY=
SCOUT_ALLOWED_ORIGIN=
SCOUT_DAILY_NEW_HANDLES=30
SCOUT_FORWARD_ENABLED=false
# How often (seconds) to refresh the markets behind forwarded picks so they can settle.
SCOUT_MARKET_REFRESH_S=600
