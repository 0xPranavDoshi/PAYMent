# Copy to .env and fill in. Never commit real keys.

# Postgres connection string.
# Local:    postgres://postgres:postgres@localhost:5432/copayme
#           (docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=copayme postgres:17)
# Supabase: Project Settings > Database > Connection string (use the pooler URI)
DATABASE_URL=

# Scoring API
PORT=8787

# Trading service
TRADING_PORT=8788
# Static key shared between services — generate with: openssl rand -hex 32
TRADING_SERVICE_KEY=

# Gemini Prediction Markets (sandbox keys from exchange.sandbox.gemini.com)
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Leave blank to use sandbox (default). Set to https://api.gemini.com for prod.
GEMINI_BASE_URL=

# Scout service (Grok pipeline)
SCOUT_PORT=8789
APIFY_ACTOR_ID=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_TOKEN=
XAI_API_KEY=
# Provisional: verify against the xAI docs once a key is available.
XAI_MODEL=grok-4-1-fast-reasoning
INGEST_URL=
INGEST_SERVICE_KEY=
SCOUT_ALLOWED_ORIGIN=
SCOUT_DAILY_NEW_HANDLES=30
SCOUT_FORWARD_ENABLED=false
