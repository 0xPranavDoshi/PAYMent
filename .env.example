# Copy to .env and fill in. Never commit real keys.

# ─────────────────────────────────────────────────────────────────────────────
# End-to-end wiring: scout → scoring API → trading service
#
#   scout ──POST /v1/posts──▶ scoring API ──POST /v1/calls/notify──▶ trading
#   (matches tweets to        (creates calls, promotes     (auto-places $1 paper
#    Gemini markets by ticker)  picks)                       watch tails + copy tails)
#
# All three services share ONE DATABASE_URL (same Supabase). Apply migrations once:
#   pnpm --filter @copayme/api db:migrate
#
# To make watch + copy trading fire from real tweets, set these — keeping the two
# key pairs identical:
#   1. SCOUT_FORWARD_ENABLED=true
#   2. scout INGEST_URL         → the scoring API URL           (e.g. http://localhost:8787)
#   3. scout INGEST_SERVICE_KEY == scoring API SCORING_SERVICE_KEY   (same value)
#   4. api   TRADING_URL        → the trading service URL       (e.g. http://localhost:8788)
#   5. api   TRADING_SERVICE_KEY == trading TRADING_SERVICE_KEY      (same value)
# Only FRESH picks auto-tail; a profile scan of old tweets never places trades, and
# you must be watching/copying a trader BEFORE their next pick for it to tail.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local:    postgres://postgres:postgres@localhost:5432/copayme
#           (docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=copayme postgres:17)
# Supabase: Connect > Direct > Session pooler URI (port 5432). Not the direct connection (IPv6 only)
#           and not the transaction pooler (no prepared statements). Add ?sslmode=require for
#           services that use their own postgres client; the scoring API requires TLS itself.
DATABASE_URL=
# Max database connections each service may open (default 3). Supabase's session pooler allows only 15 in
# total for the whole project, shared by every service every teammate runs, so keep this small.
# DB_POOL_MAX=3
# Seconds an unused connection stays open before the service closes it (default 30; 0 = never). It reopens
# on the next query, so a quiet service gives its slots back to the rest of the team.
# DB_IDLE_TIMEOUT_S=30

# Scoring API
PORT=8787
# The worker that settles picks and rescores users runs inside the API process.
# WORKER_ENABLED=false turns the schedule off; WORKER_INTERVAL_S sets the gap between runs (default 300).
WORKER_ENABLED=true
WORKER_INTERVAL_S=300
# Shared secret for POST /v1/posts (sent as the x-service-key header) - generate with: openssl rand -hex 32.
# The scout must send this SAME value as INGEST_SERVICE_KEY (see Scout section below).
SCORING_SERVICE_KEY=

# Trading service
TRADING_PORT=8788
# Where the scoring API reaches the trading service to notify it of new picks (uses TRADING_SERVICE_KEY)
TRADING_URL=http://localhost:8788
# Static key the scoring API presents to POST /v1/calls/notify, and the trading service checks.
# One value, used by both — generate with: openssl rand -hex 32
TRADING_SERVICE_KEY=
# How copy trades execute: "paper" simulates at the follower's size (works on the
# sandbox, which has no sports markets); "live" places real orders. Default: paper.
COPY_TRADE_MODE=paper

# Gemini Prediction Markets (sandbox keys from exchange.sandbox.gemini.com)
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Market data is read from production (sports markets don't exist on sandbox).
# Orders are placed on sandbox. These defaults are correct for development.
GEMINI_READ_BASE_URL=https://api.gemini.com
GEMINI_ORDER_BASE_URL=https://api.sandbox.gemini.com

# Scout service (Grok pipeline)
SCOUT_PORT=8789
APIFY_ACTOR_ID=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_TOKEN=
XAI_API_KEY=
# Verified working live on Nov 18 2026 (strict json_schema output).
XAI_MODEL=grok-4-1-fast-reasoning
# Where the scout forwards matched picks: the scoring API base URL (its PORT, default 8787).
INGEST_URL=
# Must equal the scoring API's SCORING_SERVICE_KEY above.
INGEST_SERVICE_KEY=
SCOUT_ALLOWED_ORIGIN=
SCOUT_DAILY_NEW_HANDLES=30
# Master switch: set true to forward picks to the scoring API (which then fans out to trading).
SCOUT_FORWARD_ENABLED=false
# How often (seconds) to refresh the markets behind forwarded picks so they can settle.
SCOUT_MARKET_REFRESH_S=600
# Price picks Gemini has no trade history for from the mirrored Kalshi market (public data, no key).
SCOUT_KALSHI_PRICING=true

# ── Website (apps/web) ───────────────────────────────────────────────────────
# Until X login exists, "Continue as demo user" on /signin signs in as this users.id.
# Put it in apps/web/.env.local (gitignored) or export it before `pnpm --filter @copayme/web dev`.
DEFAULT_FOLLOWER_ID=

# ── On-chain service (apps/onchain, Arc Testnet / Circle) ────────────────────
# Pays creators USDC on Arc when their picks are tailed, and lets them redeem.
# Note: 8789 is taken by the scout service, so the on-chain service uses 8790.
ONCHAIN_PORT=8790
# Shared secret the trading service sends as x-service-key to POST /v1/rewards/accrue,
# and that the website backend presents for user-scoped routes. openssl rand -hex 32.
ONCHAIN_SERVICE_KEY=
# memory = no database (demo/tests); postgres = use DATABASE_URL. Defaults to postgres if DATABASE_URL is set.
STORE=
# mock = fake tx (default, no creds); wallet = Circle dev-controlled USDC transfer; x402 = gasless Gateway nanopayment.
PAYMENT_PROVIDER=mock
# Circle developer account (testnet). Get at https://console.circle.com
CIRCLE_API_KEY=
# 32-byte hex entity secret. Created + registered by: pnpm --filter @copayme/onchain setup:treasury
CIRCLE_ENTITY_SECRET=
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=
# Local EOA private key for the x402/Gateway path only (PAYMENT_PROVIDER=x402).
TREASURY_PRIVATE_KEY=
ARC_RPC_URL=https://rpc.testnet.arc.network

# Website → on-chain + X login (put the real values in apps/web/.env.local):
#   ONCHAIN_URL=http://localhost:8790
#   ONCHAIN_SERVICE_KEY=<same as above>
#   X_CLIENT_ID= / X_CLIENT_SECRET= / X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback
