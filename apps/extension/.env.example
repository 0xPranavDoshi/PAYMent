# Scoring API the background worker calls (default: http://localhost:8787)
WXT_API_URL=http://localhost:8787
# true = show generated badges without an API, for working on x.com without a database
WXT_MOCK=false

# Base URL of the coPAYMe website, for the popover's "Open coPAYMe" link
WXT_WEB_URL=http://localhost:3000

# The trading service (Paper trade and Copy trade buttons). Default: http://localhost:8788
WXT_TRADING_URL=http://localhost:8788
# Who to trade as until the X login exists: a users.id from the shared database. Leave empty and the
# buttons say "Sign in with X to trade". Copy trading places REAL orders for this user.
WXT_FOLLOWER_ID=
