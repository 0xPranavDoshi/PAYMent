{
  "name": "copayme",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @copayme/api dev",
    "dev:scout": "pnpm --filter @copayme/scout dev",
    "dev:trading": "pnpm --filter @copayme/trading dev",
    "dev:onchain": "pnpm --filter @copayme/onchain dev",
    "dev:web": "pnpm --filter @copayme/web dev",
    "dev:extension": "pnpm --filter @copayme/extension dev",
    "package:extension": "pnpm --filter @copayme/extension package",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
